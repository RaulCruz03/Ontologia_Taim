<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.exemplo.org/taim"
         xmlns="http://www.exemplo.org/taim#">

<owl:Ontology rdf:about="http://www.exemplo.org/taim"/>

<owl:ObjectProperty rdf:about="#envolveAnimal">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="#Animal"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ocorreEm">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="#TrechoRodovia"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ocorreSob">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="#CondicaoAmbiental"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ocorreDurante">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="#PeriodoTemporal"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#possuiFatorRisco">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="#FatorRisco"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#proximoA">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="#Habitat"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#pertenceARodovia">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="#Rodovia"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contem">
  <rdfs:domain rdf:resource="#Habitat"/>
  <rdfs:range rdf:resource="#Animal"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#viveEm">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="#Habitat"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atravessaRodovia">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="#Rodovia"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#afetaVisibilidade">
  <rdfs:domain rdf:resource="#CondicaoClimatica"/>
  <rdfs:range rdf:resource="#VisibilidadeReduzida"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aumentaRisco">
  <rdfs:domain rdf:resource="#CondicaoAmbiental"/>
  <rdfs:range rdf:resource="#FatorRisco"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#nomeEspecie">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomePopular">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#kmInicial">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#kmFinal">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#coordenadaLat">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#coordenadaLon">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomeRodovia">
  <rdfs:domain rdf:resource="#Rodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dataEvento">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#horarioEvento">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#resultadoFatal">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#descricaoClima">
  <rdfs:domain rdf:resource="#CondicaoClimatica"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#temperatura">
  <rdfs:domain rdf:resource="#CondicaoClimatica"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#pluviosidade">
  <rdfs:domain rdf:resource="#CondicaoClimatica"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomeHabitat">
  <rdfs:domain rdf:resource="#Habitat"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#areaHabitat">
  <rdfs:domain rdf:resource="#Habitat"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nivelRisco">
  <rdfs:domain rdf:resource="#FatorRisco"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#descricaoRisco">
  <rdfs:domain rdf:resource="#FatorRisco"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Animal">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Habitat">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Infraestrutura">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#EventoAtropelamento">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#envolveAnimal"/>
      <owl:onClass rdf:resource="#Animal"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#ocorreEm"/>
      <owl:onClass rdf:resource="#TrechoRodovia"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#CondicaoAmbiental">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#FatorRisco">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PeriodoTemporal">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Mamifero">
  <rdfs:subClassOf rdf:resource="#Animal"/>
</owl:Class>

<owl:Class rdf:about="#Ave">
  <rdfs:subClassOf rdf:resource="#Animal"/>
</owl:Class>

<owl:Class rdf:about="#Reptil">
  <rdfs:subClassOf rdf:resource="#Animal"/>
</owl:Class>

<owl:Class rdf:about="#Capivara">
  <rdfs:subClassOf rdf:resource="#Mamifero"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#viveEm"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#Banhado"/>
            <rdf:Description rdf:about="#CorpoDagua"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Lontra">
  <rdfs:subClassOf rdf:resource="#Mamifero"/>
</owl:Class>

<owl:Class rdf:about="#Tatu">
  <rdfs:subClassOf rdf:resource="#Mamifero"/>
</owl:Class>

<owl:Class rdf:about="#Veado">
  <rdfs:subClassOf rdf:resource="#Mamifero"/>
</owl:Class>

<owl:Class rdf:about="#AveAquatica">
  <rdfs:subClassOf rdf:resource="#Ave"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#viveEm"/>
      <owl:someValuesFrom rdf:resource="#CorpoDagua"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#AveTerrestre">
  <rdfs:subClassOf rdf:resource="#Ave"/>
</owl:Class>

<owl:Class rdf:about="#Serpente">
  <rdfs:subClassOf rdf:resource="#Reptil"/>
</owl:Class>

<owl:Class rdf:about="#Tartaruga">
  <rdfs:subClassOf rdf:resource="#Reptil"/>
</owl:Class>

<owl:Class rdf:about="#Banhado">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#CorpoDagua">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#VegetacaoRiparia">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#CampoAlagado">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#Lagoa">
  <rdfs:subClassOf rdf:resource="#CorpoDagua"/>
</owl:Class>

<owl:Class rdf:about="#Rio">
  <rdfs:subClassOf rdf:resource="#CorpoDagua"/>
</owl:Class>

<owl:Class rdf:about="#Vala">
  <rdfs:subClassOf rdf:resource="#CorpoDagua"/>
</owl:Class>

<owl:Class rdf:about="#Rodovia">
  <rdfs:subClassOf rdf:resource="#Infraestrutura"/>
</owl:Class>

<owl:Class rdf:about="#TrechoRodovia">
  <rdfs:subClassOf rdf:resource="#Infraestrutura"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#pertenceARodovia"/>
      <owl:onClass rdf:resource="#Rodovia"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Ponte">
  <rdfs:subClassOf rdf:resource="#Infraestrutura"/>
</owl:Class>

<owl:Class rdf:about="#Acostamento">
  <rdfs:subClassOf rdf:resource="#Infraestrutura"/>
</owl:Class>

<owl:Class rdf:about="#CondicaoClimatica">
  <rdfs:subClassOf rdf:resource="#CondicaoAmbiental"/>
</owl:Class>

<owl:Class rdf:about="#NivelLuminosidade">
  <rdfs:subClassOf rdf:resource="#CondicaoAmbiental"/>
</owl:Class>

<owl:Class rdf:about="#Estacao">
  <rdfs:subClassOf rdf:resource="#PeriodoTemporal"/>
</owl:Class>

<owl:Class rdf:about="#Horario">
  <rdfs:subClassOf rdf:resource="#PeriodoTemporal"/>
</owl:Class>

<owl:Class rdf:about="#Chuva">
  <rdfs:subClassOf rdf:resource="#CondicaoClimatica"/>
</owl:Class>

<owl:Class rdf:about="#Neblina">
  <rdfs:subClassOf rdf:resource="#CondicaoClimatica"/>
</owl:Class>

<owl:Class rdf:about="#CeuAberto">
  <rdfs:subClassOf rdf:resource="#CondicaoClimatica"/>
</owl:Class>

<owl:Class rdf:about="#Diurno">
  <rdfs:subClassOf rdf:resource="#NivelLuminosidade"/>
</owl:Class>

<owl:Class rdf:about="#Noturno">
  <rdfs:subClassOf rdf:resource="#NivelLuminosidade"/>
</owl:Class>

<owl:Class rdf:about="#Crepuscular">
  <rdfs:subClassOf rdf:resource="#NivelLuminosidade"/>
</owl:Class>

<owl:Class rdf:about="#TrafegoVeicular">
  <rdfs:subClassOf rdf:resource="#FatorRisco"/>
</owl:Class>

<owl:Class rdf:about="#VisibilidadeReduzida">
  <rdfs:subClassOf rdf:resource="#FatorRisco"/>
</owl:Class>

<owl:Class rdf:about="#ProximidadeCorpoHidrico">
  <rdfs:subClassOf rdf:resource="#FatorRisco"/>
</owl:Class>

<owl:Class rdf:about="#AusenciaDePassagem">
  <rdfs:subClassOf rdf:resource="#FatorRisco"/>
</owl:Class>


</rdf:RDF>
